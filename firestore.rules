rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User-scoped app data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /routines/{routineId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // One doc per routine step/activity
        match /activities/{activityId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Daily trophy events — client writes when segment completes
      match /trophies/{trophyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User stats (stars) — readable by client, written by Cloud Functions/admin SDK.
      match /stats/{statsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /awards/{awardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Audio cache — open read for dev; only Cloud Functions write
    match /audio_cache/{cacheKey} {
      allow read: if true;
      allow write: if false; // Written only by Cloud Functions (admin SDK)
    }

    // Public website bootstrap config (landing video/store links)
    match /public_site/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Early access leads are written only by Cloud Functions (admin SDK).
    match /early_access/{leadId} {
      allow read, write: if false;
    }

  }
}
