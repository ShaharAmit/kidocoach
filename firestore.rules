rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User-scoped app data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /routines/{routineId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // One doc per routine step/activity
        match /activities/{activityId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Daily trophy events — client writes when segment completes
      match /trophies/{trophyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User stats (stars) — readable by client, written by Cloud Functions/admin SDK.
      match /stats/{statsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /awards/{awardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Audio cache registry — keys embed children's names, so clients never read or list it.
    // The app resolves clips only through the authenticated generate* callables.
    match /audio_cache/{cacheKey} {
      allow read, write: if false;
    }

    // Per-user TTS generation quotas — Cloud Functions only.
    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // Sign in with Apple refresh tokens (revoked on account deletion) — Cloud Functions only.
    match /apple_tokens/{uid} {
      allow read, write: if false;
    }

    // Public website bootstrap config (landing video/store links) — no personal data.
    match /public_site/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Early access leads are written only by Cloud Functions (admin SDK).
    match /early_access/{leadId} {
      allow read, write: if false;
    }

  }
}
