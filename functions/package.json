{
  "name": "kidocoach-functions",
  "description": "Firebase Cloud Functions for KidoCoach",
  "scripts": {
    "build": "tsc",
    "seed:public-site": "node scripts/seed-public-site-config.js",
    "seed:activity-catalog": "npm run build && node scripts/seed-activity-catalog.js",
    "affiliates": "npm run build --silent && node scripts/affiliate-admin.js",
    "early-access": "npm run build --silent && node scripts/early-access-admin.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@google/genai": "^2.27.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
