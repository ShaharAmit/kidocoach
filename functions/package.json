{
  "name": "kidocoach-functions",
  "description": "Firebase Cloud Functions for KidoCoach",
  "scripts": {
    "build": "tsc",
    "seed:public-site": "node scripts/seed-public-site-config.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@google/genai": "^2.27.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5",
    "firebase-functions-test": "^3.5.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "brace-expansion": "^1.1.18",
    "js-yaml": "^4.3.1",
    "minimatch": "^9.0.9",
    "protobufjs": "^7.6.5",
    "ts-deepmerge": "^8.0.0",
    "uuid": "^11.1.1",
    "websocket-driver": "^0.7.5",
    "ws": "^8.21.3"
  },
  "private": true
}
